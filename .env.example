# Copy to .env (repo root) and fill in. Never commit .env.

# --- MCP server (apps/mcp-server) ---
# Public hostnames allowed to reach /mcp when deployed (DNS-rebinding guard),
# comma-separated, or * to disable the check behind a trusted proxy.
MCP_ALLOWED_HOSTS=
# Debug endpoints (/debug/calls, /debug/reset) are on unless NODE_ENV=production.
DEBUG_CALLS=

# --- Agent API (apps/agent-api) ---
MCP_SERVER_URL=http://localhost:5100/mcp
# Sent as "Authorization: Bearer ..." to the MCP server (for when auth is enabled).
MCP_DEV_TOKEN=

# LLM engine. Empty = Anthropic if ANTHROPIC_API_KEY is set, else the offline engine.
#   anthropic | bedrock | gemini | groq | openrouter | ollama | openai-compatible | offline
LLM_PROVIDER=

# Anthropic (Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Amazon Bedrock (Converse API). Credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, a profile, or an IAM role).
AWS_REGION=
BEDROCK_MODEL_ID=

# OpenAI-compatible providers (free tiers): gemini -> gemini-2.5-flash,
# groq -> openai/gpt-oss-120b. LLM_MODEL / LLM_BASE_URL override the defaults.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
