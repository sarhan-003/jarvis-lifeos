# Copy to .env and fill in. Never commit .env.

# API server port (the Vite dev server proxies /api to it)
API_PORT=8787

# AI provider: "anthropic" uses Claude tool calling; "local" uses the built-in
# offline intent engine (no key needed, deterministic, fewer phrasings understood).
# Leave empty to auto-select: anthropic if ANTHROPIC_API_KEY is set, else local.
AI_PROVIDER=

# Claude API key from https://console.anthropic.com (server-side only)
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-opus-5-5

# Where the JSON database file is written
DATA_FILE=./data/db.json

# MCP server (/mcp, Streamable HTTP). Set a token before exposing it beyond localhost;
# clients must then send "Authorization: Bearer <token>".
MCP_AUTH_TOKEN=
# Extra Host names allowed to reach /mcp (comma-separated), e.g. a tunnel hostname.
MCP_ALLOWED_HOSTS=
# Extra browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=
