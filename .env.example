# Copy to .env and fill in. Never commit .env.

# API server port (the Vite dev server proxies /api to it)
API_PORT=8787

# AI provider. Leave empty to auto-select: Claude if ANTHROPIC_API_KEY is set,
# otherwise the built-in offline intent engine (no key, fixed phrasings only).
#   local       offline intent engine
#   anthropic   Claude (needs ANTHROPIC_API_KEY)
#   groq        free tier, https://console.groq.com        (needs LLM_API_KEY)
#   gemini      free tier, https://aistudio.google.com     (needs LLM_API_KEY)
#   openrouter  free ":free" models, https://openrouter.ai (needs LLM_API_KEY + LLM_MODEL)
#   ollama      local models, https://ollama.com           (needs LLM_MODEL, no key)
#   openai-compatible  any other Chat Completions server   (needs LLM_BASE_URL + LLM_MODEL)
AI_PROVIDER=

# Claude (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI-compatible providers (server-side only). LLM_BASE_URL and LLM_MODEL
# override the preset defaults: groq -> openai/gpt-oss-120b, gemini -> gemini-2.5-flash.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=aa

# Where the JSON database file is written
DATA_FILE=./data/db.json

# MCP server (/mcp, Streamable HTTP). Set a token before exposing it beyond localhost;
# clients must then send "Authorization: Bearer <token>".
MCP_AUTH_TOKEN=
# Extra Host names allowed to reach /mcp (comma-separated), e.g. a tunnel hostname.
MCP_ALLOWED_HOSTS=
# Extra browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=
